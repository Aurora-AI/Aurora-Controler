# ExcelReverseEngine — variáveis de ambiente
# Copie para .env e preencha com seus valores

# Provedor LLM para fases A3 e B1
# litellm aceita qualquer provider compatível com a OpenAI API
LITELLM_MODEL=gpt-4o-mini

# Chave de API do provider escolhido
OPENAI_API_KEY=sk-...

# Alternativas (descomente o provider desejado):
# ANTHROPIC_API_KEY=sk-ant-...
# LITELLM_MODEL=claude-3-haiku-20240307

# GROQ_API_KEY=gsk_...
# LITELLM_MODEL=groq/llama-3.1-8b-instant

# Configurações opcionais
# LITELLM_MAX_TOKENS=2000
# LITELLM_TEMPERATURE=0.1

# Selo criptográfico de paridade (Trustware Proof — OS-EXRS-CRYPTO-SEAL)
# Caminho para a chave privada Ed25519 (PEM) que assina o CertifiedModule.
# Espelha o padrão AURORA_MASTER_KEY_FILE do portfólio. NUNCA versionar a chave.
# Gere com:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; \
#   from cryptography.hazmat.primitives import serialization as s; k=Ed25519PrivateKey.generate(); \
#   open('exrs_signing.pem','wb').write(k.private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()))"
# EXRS_SIGNING_KEY_FILE=/caminho/para/exrs_signing.pem
